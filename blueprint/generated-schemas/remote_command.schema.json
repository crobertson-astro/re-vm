      "type": "string"
    },
    "command": {
      "description": "Command to execute remotely.",
      "title": "Command",
      "type": "string"
    },
    "pool": {
      "default": "remote_execution",
      "description": "Pool for remote-executed tasks.",
      "title": "Pool",
      "type": "string"
    },
    "blueprint": {
