{
  "additionalProperties": false,
  "properties": {
    "ssh_conn_id": {
      "default": "vendor_sftp_default",
      "description": "SFTP connection ID.",
      "title": "Ssh Conn Id",
      "type": "string"
    },
    "remote_filepath": {
      "description": "Source path on the SFTP server.",
      "title": "Remote Filepath",
      "type": "string"
    },
    "local_filepath": {
      "description": "Local destination path.",
      "title": "Local Filepath",
      "type": "string"
    },
    "create_intermediate_dirs": {
      "default": true,
      "description": "Create local directories if needed.",
      "title": "Create Intermediate Dirs",
      "type": "boolean"
    },
    "pool": {
      "default": "remote_execution",
      "description": "Pool for remote-executed tasks.",
      "title": "Pool",
      "type": "string"
    },
    "blueprint": {
      "type": "string",
      "const": "sftp_get",
      "description": "The blueprint template to use"
    },
    "version": {
      "type": "integer",
      "const": 1,
      "description": "The blueprint version"
    }
  },
  "required": [
    "blueprint",
    "version",
    "remote_filepath",
    "local_filepath"
  ],
  "title": "sftp_get",
  "type": "object",
  "$schema": "http://json-schema.org/draft-07/schema#"
}